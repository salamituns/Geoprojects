pipeline {
    agent any
    
    tools {
        jdk 'JDK-17'
        maven 'maven3.9.2'
    }
    
    environment {
        SONAR_TOKEN = credentials('sonarqube-token')
        BASE_PATH = '/geological-sample-api/'
        DOCKER_HUB_REGISTRY = 'docker.io'
        IMAGE_NAME = 'geological-sample-api'
        KUBERNETES_NAMESPACE = 'geological-sample-api'
        KUBERNETES_MASTER = '10.2.0.15'
    }
    
    stages {
        stage('1. Clone code') {
            steps {
                git branch: 'main', 
                     credentialsId: 'salamitunsjenkins', 
                     url: 'https://github.com/salamituns/Geoprojects'
            }
        }

        stage('2. Build Frontend') {
            steps {
                script {
                    echo "Building frontend with BASE_PATH=${BASE_PATH}"
                    sh '''
                      set -e
                      NODE_VERSION=v20.11.1
                      ARCH=$(uname -m)
                      case "$ARCH" in
                        x86_64) NODE_ARCH=x64 ;;
                        aarch64) NODE_ARCH=arm64 ;;
                        *) echo "Unsupported arch: $ARCH"; exit 1 ;;
                      esac
            
                      # Download portable Node.js
                      curl -fsSL https://nodejs.org/dist/${NODE_VERSION}/node-${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz -o node.tar.xz
                      mkdir -p .node
                      tar -xJf node.tar.xz -C .node --strip-components=1
            
                      export PATH="$PWD/.node/bin:$PATH"
                      node -v
                      npm -v
            
                      # Build frontend
                      cd frontend
                      npm ci
                      VITE_BASE_PATH=/geological-sample-api/ npm run build
                      cd ..
            
                      mkdir -p src/main/resources/static
                      cp -r frontend/dist/* src/main/resources/static/
                      echo "Frontend build completed and copied to static resources"
                    '''
                }
            }
        }

        stage('3. Test+Build') {
            steps {
                sh 'mvn clean package'
            }
        }
        
        stage('4. CodeQualityAnalysis') {
            steps {
                sh '''
                    mvn sonar:sonar \
                        -Dsonar.projectKey=geological-sample-api \
                        -Dsonar.host.url=http://10.2.0.7:9000 \
                        -Dsonar.token=${SONAR_TOKEN} \
                        -Dsonar.sources=src/main/java
                '''
            }
        }
        
        stage('5. Docker Login') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        sh """
                            echo 'Logging into Docker Hub (HTTPS)...'
                            echo ""
                            
                            # Check Docker version
                            echo "=== Docker Version Information ==="
                            docker --version
                            docker version --format 'Client: {{.Client.Version}}, Server: {{.Server.Version}}' 2>/dev/null || docker --version
                            echo ""
                            
                            # Login to Docker Hub (uses HTTPS by default)
                            echo "=== Attempting Docker Hub login ==="
                            echo "Registry: ${DOCKER_HUB_REGISTRY}"
                            echo "Username: \${DOCKER_USER}"
                            echo ""
                            
                            LOGIN_OUTPUT=\$(echo \${DOCKER_PASS} | docker login ${DOCKER_HUB_REGISTRY} -u \${DOCKER_USER} --password-stdin 2>&1) || {
                                LOGIN_ERROR=\$?
                                echo "\${LOGIN_OUTPUT}"
                                echo ""
                                echo "=========================================="
                                echo "ERROR: Docker Hub login failed!"
                                echo "=========================================="
                                echo ""
                                echo "Exit code: \${LOGIN_ERROR}"
                                echo ""
                                echo "TROUBLESHOOTING STEPS:"
                                echo ""
                                echo "1. Verify Docker Hub credentials are correct"
                                echo "2. Check network connectivity to Docker Hub"
                                echo "3. Verify Docker Hub account has access"
                                echo ""
                                echo "=========================================="
                                exit \${LOGIN_ERROR}
                            }
                            
                            echo "\${LOGIN_OUTPUT}"
                            echo "✓ Successfully logged into Docker Hub"
                        """
                    }
                }
            }
        }
        
        stage('6. Docker Build') {
            steps {
                script {
                    // Check Docker permissions before building
                    sh """
                        echo "=== Checking Docker Access ==="
                        if docker info > /dev/null 2>&1; then
                            echo "✓ Docker daemon is accessible"
                        else
                            echo "✗ ERROR: Cannot access Docker daemon"
                            echo ""
                            echo "Current user: \$(whoami)"
                            echo "Docker socket permissions:"
                            ls -la /var/run/docker.sock 2>/dev/null || echo "Docker socket not found"
                            echo ""
                            echo "SOLUTION: Add Jenkins user to docker group"
                            echo "  1. Run on Jenkins server:"
                            echo "     sudo usermod -aG docker jenkins"
                            echo "  2. Restart Jenkins service:"
                            echo "     sudo systemctl restart jenkins"
                            echo "  3. Or verify Jenkins user is in docker group:"
                            echo "     groups jenkins"
                            echo ""
                            echo "If Jenkins runs in a container, configure Docker socket permissions."
                            exit 1
                        fi
                        echo ""
                    """
                    
                    def pom = readMavenPom file: 'pom.xml'
                    def version = pom.version
                    
                    withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        def imageTag = "${DOCKER_USER}/${IMAGE_NAME}:${version}-${BUILD_NUMBER}"
                        def imageTagLatest = "${DOCKER_USER}/${IMAGE_NAME}:latest"
                        
                        echo "Building Docker image with tags: ${imageTag} and ${imageTagLatest}"
                        
                        sh """
                            docker build \
                                --build-arg BASE_PATH=${BASE_PATH} \
                                -t ${imageTag} \
                                -t ${imageTagLatest} \
                                .
                        """
                        
                        echo "Docker image built successfully: ${imageTag}"
                    }
                }
            }
        }
        
        stage('7. Docker Push') {
            steps {
                script {
                    def pom = readMavenPom file: 'pom.xml'
                    def version = pom.version
                    
                    withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        def imageTag = "${DOCKER_USER}/${IMAGE_NAME}:${version}-${BUILD_NUMBER}"
                        def imageTagLatest = "${DOCKER_USER}/${IMAGE_NAME}:latest"
                        
                        echo "Pushing Docker images to Docker Hub..."
                        
                        sh """
                            docker push ${imageTag} || exit 1
                            docker push ${imageTagLatest} || exit 1
                        """
                        
                        echo "Docker images pushed successfully: ${imageTag} and ${imageTagLatest}"
                    }
                }
            }
        }
        
        stage('8. ArtifactUpload') {
            steps {
                // Use managed Maven settings
                configFileProvider([configFile(fileId: 'maven-nexus-settings', variable: 'MAVEN_SETTINGS')]) {
                    sh 'mvn -s $MAVEN_SETTINGS deploy'
                }
            }
        }
        
        stage('9. Approval') {
            steps {
                script {
                    echo 'App ready for review'
                    timeout(time: 5, unit: 'HOURS') {
                        input message: 'Application is ready for deployment, please review and approve'
                    }
                }
            }
        }
        
        stage('10. Deploy to Kubernetes') {
            steps {
                script {
                    def pom = readMavenPom file: 'pom.xml'
                    def version = pom.version
                    
                    withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        def imageTag = "${DOCKER_USER}/${IMAGE_NAME}:${version}-${BUILD_NUMBER}"
                        
                        echo "=========================================="
                        echo "Deploying to Kubernetes Cluster"
                        echo "=========================================="
                        echo "Image: ${imageTag}"
                        echo "Namespace: ${KUBERNETES_NAMESPACE}"
                        echo "Cluster Master: ${KUBERNETES_MASTER}"
                        echo ""
                        
                        // Verify kubectl is available (install to workspace if needed, no sudo required)
                        sh '''
                            if ! command -v kubectl &> /dev/null; then
                                echo "kubectl not found. Installing to workspace directory..."
                                KUBECTL_DIR="$WORKSPACE/bin"
                                mkdir -p "$KUBECTL_DIR"
                                
                                KUBECTL_VERSION=$(curl -L -s https://dl.k8s.io/release/stable.txt)
                                echo "Downloading kubectl version: $KUBECTL_VERSION"
                                curl -LO "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl"
                                chmod +x kubectl
                                mv kubectl "$KUBECTL_DIR/kubectl"
                                
                                # Add to PATH for this session
                                export PATH="$KUBECTL_DIR:$PATH"
                                echo "✓ kubectl installed to $KUBECTL_DIR"
                            fi
                            
                            # Ensure kubectl is in PATH
                            export PATH="$WORKSPACE/bin:$PATH"
                            kubectl version --client
                        '''
                        
                        // Check cluster connectivity
                        sh """
                            export PATH="\$WORKSPACE/bin:\$PATH"
                            echo "Checking Kubernetes cluster connectivity..."
                            kubectl cluster-info || echo "WARNING: Cannot connect to cluster. Verify kubeconfig."
                            kubectl get nodes
                        """
                        
                        // Create namespace if it doesn't exist
                        sh """
                            export PATH="\$WORKSPACE/bin:\$PATH"
                            echo "Ensuring namespace exists..."
                            kubectl get namespace ${KUBERNETES_NAMESPACE} || kubectl create namespace ${KUBERNETES_NAMESPACE}
                        """
                        
                        // Create/update image pull secret for Docker Hub
                        sh """
                            export PATH="\$WORKSPACE/bin:\$PATH"
                            echo "Creating/updating Docker Hub image pull secret..."
                            kubectl create secret docker-registry docker-hub-registry-secret \
                                --docker-server=${DOCKER_HUB_REGISTRY} \
                                --docker-username=\${DOCKER_USER} \
                                --docker-password=\${DOCKER_PASS} \
                                --namespace=${KUBERNETES_NAMESPACE} \
                                --dry-run=client -o yaml | kubectl apply -f -
                        """
                    
                        // Update deployment manifest with new image tag
                        sh """
                            echo "Updating deployment with image: ${imageTag}"
                            # Create temporary deployment file with updated image
                            sed 's|image:.*geological-sample-api.*|image: ${imageTag}|g' k8s/deployment.yaml > k8s/deployment-${BUILD_NUMBER}.yaml
                        """
                        
                        // Apply Kubernetes manifests
                        sh """
                            export PATH="\$WORKSPACE/bin:\$PATH"
                            echo "Applying Kubernetes manifests..."
                            kubectl apply -f k8s/namespace.yaml
                            kubectl apply -f k8s/deployment-${BUILD_NUMBER}.yaml
                            kubectl apply -f k8s/service.yaml
                        """
                        
                        // Wait for deployment rollout
                        sh """
                            export PATH="\$WORKSPACE/bin:\$PATH"
                            echo "Waiting for deployment rollout..."
                            if kubectl rollout status deployment/geological-sample-api \
                                -n ${KUBERNETES_NAMESPACE} \
                                --timeout=300s 2>&1; then
                                echo "✓ Deployment rollout successful"
                            else
                                ROLLOUT_ERROR=\$?
                                echo ""
                                echo "=========================================="
                                echo "ERROR: Deployment rollout failed or timed out"
                                echo "=========================================="
                                echo ""
                                echo "Checking pod status and events..."
                                echo ""
                                echo "=== Pod Status ==="
                                kubectl get pods -n ${KUBERNETES_NAMESPACE} -l app=geological-sample-api
                                echo ""
                                echo "=== Pod Events ==="
                                kubectl get events -n ${KUBERNETES_NAMESPACE} --sort-by='.lastTimestamp' | tail -20
                                echo ""
                                echo "=== Pod Describe (for detailed errors) ==="
                                POD_NAME=\$(kubectl get pods -n ${KUBERNETES_NAMESPACE} -l app=geological-sample-api -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
                                if [ -n "\$POD_NAME" ]; then
                                    kubectl describe pod \$POD_NAME -n ${KUBERNETES_NAMESPACE} | tail -50
                                fi
                                echo ""
                                echo "=========================================="
                                echo "TROUBLESHOOTING: Image Pull Failure"
                                echo "=========================================="
                                echo ""
                                echo "The error 'trying and failing to pull image' usually means:"
                                echo "1. Image pull secret is not working correctly"
                                echo "2. Network connectivity issues to Docker Hub"
                                echo "3. Docker Hub authentication failed"
                                echo ""
                                echo "SOLUTION: Verify Docker Hub image pull secret"
                                echo ""
                                echo "Verify image pull secret exists:"
                                echo "  kubectl get secret docker-hub-registry-secret -n ${KUBERNETES_NAMESPACE}"
                                echo ""
                                echo "Check secret details:"
                                echo "  kubectl describe secret docker-hub-registry-secret -n ${KUBERNETES_NAMESPACE}"
                                echo ""
                                echo "Verify Docker Hub credentials are correct in Jenkins credentials store"
                                echo ""
                                exit \${ROLLOUT_ERROR}
                            fi
                        """
                        
                        // Verify deployment
                        sh """
                            export PATH="\$WORKSPACE/bin:\$PATH"
                            echo ""
                            echo "=========================================="
                            echo "Deployment Verification"
                            echo "=========================================="
                            echo ""
                            echo "=== Pods Status ==="
                            kubectl get pods -n ${KUBERNETES_NAMESPACE} -l app=geological-sample-api
                            echo ""
                            echo "=== Service Status ==="
                            kubectl get svc -n ${KUBERNETES_NAMESPACE}
                            echo ""
                            echo "=== Deployment Status ==="
                            kubectl get deployment -n ${KUBERNETES_NAMESPACE}
                        """
                        
                        // Get service details
                        def nodePort = sh(
                            script: "export PATH=\"\$WORKSPACE/bin:\$PATH\" && kubectl get svc geological-sample-api -n ${KUBERNETES_NAMESPACE} -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null || echo '30080'",
                            returnStdout: true
                        ).trim()
                        
                        def workerNodes = sh(
                            script: "export PATH=\"\$WORKSPACE/bin:\$PATH\" && kubectl get nodes -o jsonpath='{.items[?(@.metadata.labels.kubernetes\\.io/role==\"node\")].status.addresses[?(@.type==\"InternalIP\")].address}'",
                            returnStdout: true
                        ).trim()
                        
                        def workerIPs = workerNodes.split('\\s+')
                        def primaryWorkerIP = workerIPs.length > 0 ? workerIPs[0] : '10.2.0.14'
                        
                        echo ""
                        echo "=========================================="
                        echo "SUCCESS: Application Deployed to Kubernetes"
                        echo "=========================================="
                        echo "Image Tag: ${imageTag}"
                        echo "Namespace: ${KUBERNETES_NAMESPACE}"
                        echo ""
                        echo "Access URLs:"
                        echo "  Worker Node 1: http://${primaryWorkerIP}:${nodePort}"
                        if (workerIPs.length > 1) {
                            echo "  Worker Node 2: http://${workerIPs[1]}:${nodePort}"
                        }
                        echo ""
                        echo "Health Check:"
                        echo "  http://${primaryWorkerIP}:${nodePort}/healthcheck"
                        echo "=========================================="
                        
                        // Test health endpoint
                        sh """
                            echo "Testing health endpoint..."
                            sleep 10
                            curl -s http://${primaryWorkerIP}:${nodePort}/healthcheck || echo "Health check not yet available (application may still be starting)"
                        """
                        
                        // Cleanup temporary file
                        sh "rm -f k8s/deployment-${BUILD_NUMBER}.yaml || true"
                    }
                }
            }
        }
        
    }
    
    post {
        success {
            script {
                def nodePort = sh(
                    script: "export PATH=\"\$WORKSPACE/bin:\$PATH\" && kubectl get svc geological-sample-api -n ${KUBERNETES_NAMESPACE} -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null || echo '30080'",
                    returnStdout: true
                ).trim()
                def workerIPs = sh(
                    script: "export PATH=\"\$WORKSPACE/bin:\$PATH\" && kubectl get nodes -o jsonpath='{.items[?(@.metadata.labels.kubernetes\\.io/role==\"node\")].status.addresses[?(@.type==\"InternalIP\")].address}'",
                    returnStdout: true
                ).trim().split('\\s+')
                def primaryWorkerIP = workerIPs.length > 0 ? workerIPs[0] : '10.2.0.14'
                
                echo "=========================================="
                echo "Pipeline Succeeded!"
                echo "=========================================="
                echo "Application deployed to Kubernetes"
                echo "Access URL: http://${primaryWorkerIP}:${nodePort}"
                echo "Health Check: http://${primaryWorkerIP}:${nodePort}/healthcheck"
                echo "=========================================="
            }
        }
        failure {
            echo 'Pipeline failed! Check logs for details.'
            script {
                // Show Kubernetes pod logs on failure
                sh """
                    export PATH="\$WORKSPACE/bin:\$PATH"
                    echo "=== Recent Pod Logs ==="
                    kubectl logs -n ${KUBERNETES_NAMESPACE} -l app=geological-sample-api --tail=50 || echo "Could not retrieve logs"
                """
            }
        }
    }
}
